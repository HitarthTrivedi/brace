{
  "name": "brace-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted backend for the Brace website chat widget: crawls a site, indexes it locally, answers questions via a free LLM API.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "crawl": "node src/crawl-cli.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
