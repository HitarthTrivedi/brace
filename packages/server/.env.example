# The real site Scout should crawl and answer questions about.
SITE_BASE_URL=https://example.com

# --- LLM (chat/answer step only — indexing is local and free, see src/embeddings.js) ---
# Default: Groq. See ../../docs/GET_API_KEY.md for how to get each of these.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Alternative — OpenRouter (one key, many models — good for testing):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=
# Optional but recommended by OpenRouter for attribution/analytics on your key:
# OPENROUTER_SITE_URL=http://localhost:4000
# OPENROUTER_APP_NAME=Scout

# Alternative — Gemini (uncomment and comment out the block above):
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=

PORT=4000
